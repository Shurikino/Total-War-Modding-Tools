{
  "version": 3,
  "configurePresets": [
    {
      "name": "_base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      },
      "vendor": {
        "jetbrains.com/clion": {
          "toolchain": "Visual Studio"
        }
      }
    },
    {
      "name": "_vs2022",
      "hidden": true,
      "inherits": "_base"
    },
    {
      "name": "rome2",
      "inherits": "_vs2022",
      "displayName": "Rome 2 (Debug)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "TW_GAME": "rome2"
      }
    },
    {
      "name": "attila",
      "inherits": "_vs2022",
      "displayName": "Attila (Debug)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "TW_GAME": "attila"
      }
    },
    {
      "name": "rome2-release",
      "inherits": "_vs2022",
      "displayName": "Rome 2 (Release)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "TW_GAME": "rome2"
      }
    },
    {
      "name": "attila-release",
      "inherits": "_vs2022",
      "displayName": "Attila (Release)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "TW_GAME": "attila"
      }
    },
    {
      "name": "ci-release",
      "inherits": "_base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "attila",
      "configurePreset": "attila",
      "targets": ["twdll"]
    }
  ]
}